{
  "zip": [
    { "note": "flat set", "members": ["mod.utoc", "mod.ucas", "mod.pak"],
      "expect": { "result": "ok", "base": "mod" } },
    { "note": "nested set with .sig; directory entries ignored",
      "members": ["Content/", "Content/Paks/~mods/x_P.utoc", "Content/Paks/~mods/x_P.ucas", "Content/Paks/~mods/x_P.pak", "Content/Paks/~mods/x_P.sig"],
      "expect": { "result": "ok", "base": "x_P" } },
    { "note": "unrelated files are ignored", "members": ["readme.txt", "cover.png", "mod.utoc", "mod.ucas", "mod.pak"],
      "expect": { "result": "ok", "base": "mod" } },
    { "note": "extensions are case-insensitive", "members": ["MOD.UTOC", "MOD.UCAS", "MOD.PAK"],
      "expect": { "result": "ok", "base": "MOD" } },
    { "note": "one complete set plus a stray incomplete group", "members": ["a.utoc", "a.ucas", "a.pak", "b.utoc"],
      "expect": { "result": "ok", "base": "a" } },
    { "note": "two complete sets", "members": ["a.utoc", "a.ucas", "a.pak", "b.utoc", "b.ucas", "b.pak"],
      "expect": { "result": "multiple-sets" } },
    { "note": "missing .pak", "members": ["mod.utoc", "mod.ucas"],
      "expect": { "result": "incomplete" } },
    { "note": "no container files at all", "members": ["readme.txt"],
      "expect": { "result": "incomplete" } },
    { "note": "base names must match", "members": ["a.utoc", "b.ucas", "b.pak"],
      "expect": { "result": "incomplete" } },
    { "note": "base names are case-sensitive", "members": ["Mod.utoc", "mod.ucas", "mod.pak"],
      "expect": { "result": "incomplete" } },
    { "note": "path traversal", "members": ["../evil.utoc", "mod.utoc", "mod.ucas", "mod.pak"],
      "expect": { "result": "unsafe-path" } },
    { "note": "backslash path traversal", "members": ["dir\\..\\..\\mod.utoc", "mod.ucas", "mod.pak"],
      "expect": { "result": "unsafe-path" } },
    { "note": "absolute path", "members": ["/abs/mod.utoc", "mod.ucas", "mod.pak"],
      "expect": { "result": "unsafe-path" } },
    { "note": "drive-rooted path", "members": ["C:/x/mod.utoc", "mod.ucas", "mod.pak"],
      "expect": { "result": "unsafe-path" } }
  ],
  "raw": [
    { "note": "complete set", "files": ["mod.utoc", "mod.ucas", "mod.pak"],
      "expect": { "result": "ok", "base": "mod" } },
    { "note": "complete set with .sig", "files": ["mod.pak", "mod.sig", "mod.ucas", "mod.utoc"],
      "expect": { "result": "ok", "base": "mod" } },
    { "note": "missing .ucas", "files": ["mod.utoc", "mod.pak", "mod.sig"],
      "expect": { "result": "incomplete" } },
    { "note": "too few files", "files": ["mod.utoc", "mod.ucas"],
      "expect": { "result": "bad-files" } },
    { "note": "too many files", "files": ["mod.utoc", "mod.ucas", "mod.pak", "mod.sig", "mod.txt"],
      "expect": { "result": "bad-files" } },
    { "note": "wrong extension", "files": ["mod.utoc", "mod.ucas", "mod.txt"],
      "expect": { "result": "bad-files" } },
    { "note": "names differ", "files": ["a.utoc", "a.ucas", "b.pak"],
      "expect": { "result": "name-mismatch" } }
  ]
}
